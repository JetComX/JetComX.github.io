<article class="post-full">
  <header class="post-header">
    <h1 class="post-title"><%= page.title %></h1>
    <time class="post-date" datetime="<%= date_xml(page.date) %>"><%= date(page.date, theme.date_format) %></time>
  </header>
  <div class="post-content">
    <%- page.content %>
  </div>
</article>
