<!DOCTYPE html>
<html lang="<%= config.language %>" data-theme="light">
<%- partial('partial/head') %>
<body>
  <div class="container">
    <%- partial('partial/header') %>
    <main class="main">
      <%- body %>
    </main>
    <%- partial('partial/footer') %>
  </div>
  <script>
    (function(){
      var html = document.documentElement;
      var scheme = '<%= theme.color_scheme || "auto" %>';
      var currentTheme = scheme !== 'auto' ? scheme : 'light';

      // Safe localStorage wrapper
      function loadTheme() {
        try {
          return localStorage.getItem('theme');
        } catch(e) {
          return null;
        }
      }
      function saveTheme(t) {
        try {
          localStorage.setItem('theme', t);
        } catch(e) {}
      }

      function applyTheme(t) {
        if (t === 'auto') {
          currentTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        } else {
          currentTheme = t;
        }
        html.setAttribute('data-theme', currentTheme);
      }

      // Init
      var saved = loadTheme();
      if (saved) {
        applyTheme(saved);
      } else if (scheme === 'auto') {
        applyTheme('auto');
      } else {
        applyTheme(scheme);
      }

      // System theme change listener
      try {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
          var cur = loadTheme();
          if (!cur || cur === 'auto') {
            applyTheme('auto');
          }
        });
      } catch(e) {}

      // Toggle function exposed globally
      window.toggleTheme = function() {
        var cur = html.getAttribute('data-theme');
        var next;
        if (cur === 'dark') {
          next = 'light';
        } else if (cur === 'light' && scheme === 'auto') {
          next = 'auto';
        } else if (cur === 'light') {
          next = 'dark';
        } else {
          next = 'dark';
        }
        saveTheme(next);
        applyTheme(next);
      };
    })();
  </script>
</body>
</html>
