<!DOCTYPE html>
<html lang="<%= config.language %>" data-theme="light">
<%- partial('partial/head') %>
<body>
  <div class="container">
    <% if (is_post()) { %>
      <%- partial('partial/post-header') %>
    <% } else { %>
      <%- partial('partial/header') %>
    <% } %>
    <main class="main">
      <%- body %>
    </main>
    <% if (!is_post()) { %>
      <%- partial('partial/footer') %>
    <% } %>
  </div>
</body>
</html>
