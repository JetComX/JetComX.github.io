<header class="header">
  <button class="theme-toggle" id="themeToggle" onclick="toggleTheme()" aria-label="Toggle dark/light mode" title="Toggle dark/light mode">
    <svg class="icon-sun" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="5"/>
      <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
      <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
    </svg>
    <svg class="icon-moon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
    </svg>
  </button>
  <h1 class="site-title"><a href="<%- url_for('/') %>"><%= config.title %></a></h1>
  <% if (config.subtitle) { %>
  <p class="site-subtitle"><%= config.subtitle %></p>
  <% } %>
  <% if (theme.nav && Object.keys(theme.nav).length > 0) { %>
  <nav class="nav">
    <% for (var i in theme.nav) { %>
    <a class="nav-link" href="<%- url_for(theme.nav[i]) %>"><%= i %></a>
    <% } %>
  </nav>
  <% } %>
  <% if (theme.contacts && theme.contacts.length) { %>
  <div class="contact-section">
    <h3 class="contact-title">联系方式</h3>
    <div class="contact-row">
      <% theme.contacts.forEach(function(c) { %>
      <a class="contact-item" href="<%= c.url %>" target="_blank" rel="noopener" title="<%= c.name %>">
        <img class="contact-icon" src="<%- url_for(c.icon) %>" alt="<%= c.name %>" loading="lazy">
        <span class="contact-name"><%= c.name %></span>
      </a>
      <% }) %>
    </div>
  </div>
  <% } %>
</header>
