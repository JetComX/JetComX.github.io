<section class="post-list">
  <% page.posts.each(function(post) { %>
  <article class="post-card" onclick="location.href='<%- url_for(post.path) %>'">
    <h2 class="post-title"><%= post.title %></h2>
    <time class="post-date" datetime="<%= date_xml(post.date) %>"><%= date(post.date, theme.date_format) %></time>
    <% if (theme.excerpt && post.excerpt) { %>
    <div class="post-excerpt"><%- post.excerpt %></div>
    <% } %>
  </article>
  <% }) %>
</section>
<article class="post-card" onclick="location.href='/message-board/'">
  <h2 class="post-title">留言板</h2>
  <div class="post-excerpt">留下你的想法，和我分享一句话。</div>
</article>
<%- partial('partial/pagination') %>
